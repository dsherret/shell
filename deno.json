{
  "name": "@david/shell",
  "nodeModulesDir": "none",
  "test": {
    "permissions": {
      "all": true
    },
    "sanitizeOps": true,
    "sanitizeResources": true
  },
  "tasks": {
    "dnt": "deno run -A ./scripts/buildNpm.ts",
    "test": "deno test -P && deno task test:node",
    "test:node": "unset FORCE_COLOR && NODE_OPTIONS=--test-isolation=none npx --yes deno-test@1.0.3",
    "test:npm": "deno run -A ./scripts/smokeTestNpm.ts",
    "wasmbuild": "deno run -A @deno/wasmbuild --inline --out ./src/lib"
  },
  "fmt": {
    "proseWrap": "preserve",
    "operatorPosition": "nextLine",
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": ["ban-types", "no-explicit-any", "no-this-alias", "no-process-global"],
      "include": [
        "no-console",
        "no-sync-fn-in-async-fn"
      ]
    }
  },
  "publish": {
    "exclude": [
      "src/rs_lib",
      "src/test",
      "scripts",
      "**/*.test.*",
      "dprint.json"
    ]
  },
  "exclude": [
    ".gitattributes",
    ".gitignore",
    ".github",
    ".rustfmt.toml",
    ".vscode",
    "Cargo.toml",
    "Cargo.lock",
    "scripts/smokeTestNpm.mjs",
    "npm/",
    "target/"
  ],
  "exports": {
    ".": "./mod.ts",
    "./internal": "./internal.ts"
  },
  "imports": {
    "@david/console-static-text": "jsr:@david/console-static-text@^0.3.4",
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@david/path": "jsr:@david/path@^0.3.3",
    "@david/publish-on-tag": "jsr:@david/publish-on-tag@0.2.0",
    "@david/temp": "jsr:@david/temp@^0.2.1",
    "@deno/wasmbuild": "jsr:@deno/wasmbuild@^0.22.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fmt": "jsr:@std/fmt@1",
    "@std/io": "jsr:@std/io@^0.225",
    "@std/path": "jsr:@std/path@1",
    "esbuild": "npm:esbuild@^0.28.1",
    "which": "jsr:@david/which@^0.7.3"
  }
}
