{
  "exec": {
    "cwd": "${configDir}",
    "commands": [{
      "command": "rustfmt",
      "exts": ["rs"]
    }]
  },
  "typescript": {
    "deno": true,
    "lineWidth": 120,
    "binaryExpression.operatorPosition": "nextLine"
  },
  "markdown": {
    "lineWidth": 120
  },
  "excludes": [
    "target",
    "**/*.generated.js"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.2",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
  ]
}
